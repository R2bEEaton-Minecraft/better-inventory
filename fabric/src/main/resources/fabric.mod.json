{
	"schemaVersion": 1,
	"id": "better-inventory",
	"version": "${version}",
	"name": "Better Inventory",
	"description": "A seamless fourth inventory row with a swappable alternate hotbar.",
	"authors": [
		"R2bEEaton"
	],
	"contact": {
		"homepage": "https://github.com/R2bEEaton-Minecraft/better-inventory",
		"sources": "https://github.com/R2bEEaton-Minecraft/better-inventory"
	},
	"license": "CC0-1.0",
	"icon": "assets/better-inventory/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"cc.spea.betterinventory.BetterInventory"
		],
		"client": [
			"cc.spea.betterinventory.client.BetterInventoryClient"
		]
	},
	"mixins": [
		"better-inventory.mixins.json",
		{
			"config": "better-inventory.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
